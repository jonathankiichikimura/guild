<nav class="navbar navbar-expand-sm navbar-guild">
  <div class="container-fluid">
    <%= link_to root_path, class: "navbar-brand" do %>
      <i class="fa-solid fa-shield-halved me-2"></i>Guild
    <% end %>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav me-auto">
        <li class="nav-item">
          <%= link_to "Quests", quests_path, class: "nav-link" %>
        </li>
      </ul>

      <ul class="navbar-nav ms-auto align-items-center">
        <% if accepter_signed_in? || giver_signed_in? %>
          <li class="nav-item dropdown">
            <a href="#" class="nav-link dropdown-toggle d-flex align-items-center gap-2" id="navbarDropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
              <i class="fa-solid fa-circle-user fa-lg"></i>
              <span class="d-none d-sm-inline"><%= giver_signed_in? ? current_giver.first_name : current_accepter.full_name %></span>
            </a>
            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                <%= link_to "My Profile", giver_signed_in? ? giver_path(current_giver) : accepter_path(current_accepter), class: "dropdown-item" %>
              <hr class="dropdown-divider">
                <%= link_to "Log out", giver_signed_in? ? destroy_giver_session_path : destroy_accepter_session_path, data: { turbo_method: :delete }, class: "dropdown-item text-danger" %>
            </div>
          </li>
        <% else %>
          <li class="nav-item">
            <%# Will handle case where new user is actually an accepter rather than a giver. Default to giver%>
            <%= link_to "Sign In", new_giver_session_path, class: "nav-link" %>
          </li>
          <li class="nav-item ms-2">
            <%= link_to "Join Guild", new_giver_registration_path, class: "btn btn-mustard btn-sm" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>
