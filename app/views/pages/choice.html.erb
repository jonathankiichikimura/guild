<div class="choice-page py-6">
  <div class="container">

    <div class="text-center mb-5">
      <div class="step-icon-wrap mb-3">
        <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
      </div>
      <h1 class="section-title">How would you like to join Guild?</h1>
      <p class="section-subtitle">
        Choose the role that fits you — you can always explore the other side later.
      </p>
    </div>

    <div class="row justify-content-center g-4">

      <%# ── Giver card ── %>
      <div class="col-md-5">
        <div class="choice-card for-you-card for-you-giver p-4 p-md-5 h-100 d-flex flex-column">
          <div class="text-center mb-4">
            <div class="step-icon-wrap mb-3">
              <i class="fa-solid fa-heart"></i>
            </div>
            <h2 class="choice-card__title">I'm a Giver</h2>
            <p class="choice-card__subtitle">
              I'm an older adult looking for reliable help with everyday tasks around the house or community.
            </p>
          </div>

          <ul class="benefit-list mb-4">
            <li><i class="fa-solid fa-check me-2"></i>Post quests in minutes</li>
            <li><i class="fa-solid fa-check me-2"></i>Helpers come to you</li>
            <li><i class="fa-solid fa-check me-2"></i>Pay a fair reward in yen</li>
          </ul>

          <div class="mt-auto">
            <%= link_to new_giver_registration_path, class: "btn btn-imperial w-100 choice-card__btn" do %>
              <i class="fa-solid fa-heart me-2"></i>Join as a Giver
            <% end %>
          </div>
        </div>
      </div>

      <%# ── Accepter card ── %>
      <div class="col-md-5">
        <div class="choice-card for-you-card for-you-accepter p-4 p-md-5 h-100 d-flex flex-column">
          <div class="text-center mb-4">
            <div class="step-icon-wrap choice-card__icon--accepter mb-3">
              <i class="fa-solid fa-bolt"></i>
            </div>
            <h2 class="choice-card__title">I'm an Accepter</h2>
            <p class="choice-card__subtitle">
              I'm a younger community member who wants to help neighbours and earn rewards for my time.
            </p>
          </div>

          <ul class="benefit-list mb-4">
            <li><i class="fa-solid fa-check me-2"></i>Browse quests near you</li>
            <li><i class="fa-solid fa-check me-2"></i>Choose tasks that fit your skills</li>
            <li><i class="fa-solid fa-check me-2"></i>Earn yen rewards instantly</li>
          </ul>

          <div class="mt-auto">
            <%= link_to new_accepter_registration_path, class: "btn btn-mustard w-100 choice-card__btn" do %>
              <i class="fa-solid fa-bolt me-2"></i>Join as an Accepter
            <% end %>
          </div>
        </div>
      </div>

    </div>

    <p class="text-center mt-4 choice-page__signin">
      Already have an account?
      <%= link_to "Sign in as a Giver", new_giver_session_path %> or
      <%= link_to "sign in as an Accepter", new_accepter_session_path %>
    </p>

  </div>
</div>
